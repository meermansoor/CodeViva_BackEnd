# Application Ports
PORT=5000
SOCKET_PORT=3000

# Database Configuration (Optional, has fallback in config)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster

# External Services (Optional, has fallback)
# PYTHON_BRIDGE_URL=http://localhost:8100

# Authentication (Optional, has fallback)
# JWT_SECRET=your_jwt_secret_key_here

# File Uploads (Optional, has fallback)
# UPLOAD_DIR=./uploads

# Email Service Configuration (Required for sending invitations/notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
